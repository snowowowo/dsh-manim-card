{
  "name": "dsh-manim-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manim 卡片：AI 在聊天里写 Python Manim 代码，当场在聊天流卡片里渲染（专注聊天流卡片的小插件，可独立运行）",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "assets",
    "skills",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run --testTimeout=30000",
    "test:net": "MANIM_NET=1 vitest run --testTimeout=300000",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**/*.{ts,tsx,js}' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/**/*.generated.ts' --testTimeout=30000",
    "gen-skill": "node scripts/gen-skill.mjs",
    "docs": "pnpm --dir docs install --frozen-lockfile && pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs install --frozen-lockfile && pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs install --frozen-lockfile && pnpm --dir docs preview",
    "docs:offline": "pnpm --dir docs install --frozen-lockfile && pnpm --dir docs offline"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@shikijs/langs": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@vitest/coverage-v8": "^5.0.3",
    "lightningcss": "^1.33.0",
    "lucide-react": "^0.548.0",
    "manim-live": "^0.3.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "meta": {
      "title": "Manim Card",
      "description": "AI 写的 Python Manim 代码在聊天流卡片里当场渲染"
    }
  }
}
